{
  "protocolVersion": "0.2.0",
  "nodeId": "pi_dev",
  "packageId": "pi-dev",
  "version": "0.1.0",
  "purpose": "Specialized isolated scout, architect, implementation worker, and source-read-only reviewer agents for caller-selected working directories.",
  "tags": [
    "agents",
    "software-development"
  ],
  "agents": {
    "scout": {
      "description": "Fast read-only codebase exploration agent.",
      "tools": [
        "read",
        "grep",
        "find",
        "ls"
      ],
      "systemPrompt": {
        "file": "./prompts/scout.md",
        "mode": "replace"
      },
      "modelHint": {
        "tier": "fast",
        "thinkingLevel": "low"
      }
    },
    "architect": {
      "description": "Read-only software architect.",
      "tools": [
        "read",
        "grep",
        "find",
        "ls"
      ],
      "systemPrompt": {
        "file": "./prompts/architect.md",
        "mode": "replace"
      },
      "modelHint": {
        "tier": "reasoning",
        "thinkingLevel": "high"
      }
    },
    "worker": {
      "description": "Implementation worker with direct cwd mutation.",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "bash",
        "edit",
        "write"
      ],
      "systemPrompt": {
        "file": "./prompts/worker.md",
        "mode": "replace"
      },
      "modelHint": {
        "tier": "balanced",
        "thinkingLevel": "medium"
      }
    },
    "reviewer": {
      "description": "Source-read-only code reviewer with constrained git/test execution.",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "review_command"
      ],
      "systemPrompt": {
        "file": "./prompts/reviewer.md",
        "mode": "replace"
      },
      "modelHint": {
        "tier": "reasoning",
        "thinkingLevel": "high"
      }
    },
    "security_reviewer": {
      "description": "Source-read-only security reviewer with constrained git/test execution.",
      "tools": [
        "read",
        "grep",
        "find",
        "ls",
        "review_command"
      ],
      "systemPrompt": {
        "file": "./prompts/security-reviewer.md",
        "mode": "replace"
      },
      "modelHint": {
        "tier": "reasoning",
        "thinkingLevel": "high"
      }
    }
  },
  "provides": [
    {
      "name": "scout",
      "description": "Quickly locate relevant files, trace code paths, and return concise read-only findings.",
      "inputSchema": {
        "type": "object",
        "required": [
          "task"
        ],
        "properties": {
          "task": {
            "type": "string"
          },
          "cwd": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "thinkingLevel": {
            "type": "string",
            "enum": [
              "off",
              "minimal",
              "low",
              "medium",
              "high",
              "xhigh"
            ]
          },
          "timeoutMs": {
            "type": "integer"
          },
          "scope": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "questions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      },
      "outputSchema": {
        "type": "object",
        "required": [
          "summary",
          "files",
          "codePaths",
          "findings",
          "unresolvedQuestions",
          "diagnostics",
          "message"
        ],
        "properties": {
          "summary": {
            "type": "string"
          },
          "files": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "path",
                "relevance"
              ],
              "properties": {
                "path": {
                  "type": "string"
                },
                "line": {
                  "type": "integer"
                },
                "relevance": {
                  "type": "string"
                }
              }
            }
          },
          "codePaths": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "from",
                "to",
                "relationship"
              ],
              "properties": {
                "from": {
                  "type": "string"
                },
                "to": {
                  "type": "string"
                },
                "relationship": {
                  "type": "string"
                }
              }
            }
          },
          "findings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "unresolvedQuestions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "execution": {
        "type": "agent",
        "agent": "scout"
      },
      "effects": [
        "file_read",
        "model_network"
      ]
    },
