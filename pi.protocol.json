          },
          "diagnostics": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "message": {
            "type": "string"
          }
        }
      },
      "execution": {
        "type": "agent",
        "agent": "architect"
      },
      "effects": [
        "file_read",
        "model_network"
      ]
    },
