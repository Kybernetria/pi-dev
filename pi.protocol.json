              "type": "object",
              "required": [
                "order",
                "action",
                "rationale"
              ],
              "properties": {
                "order": {
                  "type": "integer"
                },
                "action": {
                  "type": "string"
                },
                "rationale": {
                  "type": "string"
                }
              }
            }
          },
          "risks": {
            "type": "array",
